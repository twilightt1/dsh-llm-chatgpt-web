{
  "name": "dsh-llm-chatgpt-web",
  "description": "ChatGPT Web (owned Chromium driving Temporary Chat) adapter for the DeepSeek Harness LLM seam",
  "version": "0.6.0",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "bin": {
    "dsh-chatgpt-web-mcp": "./lib/mcp-main.js",
    "dsh-chatgpt-web-native": "./lib/native-setup-main.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml",
    "cordis.yml.example",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "chatgpt-web",
    "llm",
    "adapter",
    "provider",
    "plugin",
    "bundle"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fflate": "0.8.3",
    "playwright-core": "^1.62.0",
    "turndown": "7.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@types/node": "^22.0.0",
    "@types/turndown": "5.0.5",
    "tsdown": "^0.22.2",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twilightt1/dsh-llm-chatgpt-web.git"
  },
  "bugs": {
    "url": "https://github.com/twilightt1/dsh-llm-chatgpt-web/issues"
  },
  "homepage": "https://github.com/twilightt1/dsh-llm-chatgpt-web#readme"
}
